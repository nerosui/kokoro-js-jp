{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    // test/cdn-entry.test.ts imports rollup.config.js to assert the build actually
    // emits the CDN entry declared in package.json. checkJs stays off, so the
    // plain-JS config is inferred, not type-checked.
    "allowJs": true,
    "isolatedModules": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true
  },
  "include": ["src", "test"]
}
